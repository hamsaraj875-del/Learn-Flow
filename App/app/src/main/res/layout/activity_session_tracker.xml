<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_surface">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/timerSection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/sessionSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="1">

        <TextView
            android:id="@+id/txtTimerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Study Timer"
            android:textColor="@color/orange"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/circularProgress"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="100"
            app:indicatorSize="240dp"
            app:trackThickness="12dp"
            app:indicatorColor="@color/orange"
            app:trackColor="#333333"
            app:trackCornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtTimerTitle"
            app:layout_constraintBottom_toTopOf="@id/timerButtons"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/txtTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25:00"
            android:textColor="@android:color/white"
            android:textSize="42sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/circularProgress"
            app:layout_constraintBottom_toBottomOf="@id/circularProgress"
            app:layout_constraintStart_toStartOf="@id/circularProgress"
            app:layout_constraintEnd_toEndOf="@id/circularProgress"/>

        <LinearLayout
            android:id="@+id/timerButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start"
                android:backgroundTint="@color/orange"
                android:textColor="@android:color/white"/>

            <Button
                android:id="@+id/btnPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pause"
                android:visibility="gone"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/orange"
                android:textColor="@android:color/white"/>

            <Button
                android:id="@+id/btnResume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resume"
                android:visibility="gone"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/orange"
                android:textColor="@android:color/white"/>

            <Button
                android:id="@+id/btnEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End"
                android:visibility="gone"
                android:layout_marginStart="8dp"
                android:backgroundTint="#D32F2F"
                android:textColor="@android:color/white"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SESSION SECTION -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sessionSection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/timerSection"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="0.5">

        <TextView
            android:id="@+id/txtSessionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Study Sessions"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sessionRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:padding="6dp"
            app:layout_constraintTop_toBottomOf="@id/txtSessionTitle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>