<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- App blocker (replaces the accessibility service) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".LearnFlowApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LearnFlow"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".AppBlockerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".BlockedActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop" />

        <service
            android:name=".AppBlockerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="focus_app_blocker" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Chat"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Login"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SignUp"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Promo"
            android:exported="false"
            android:theme="@style/Theme.LearnFlow"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Otp"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ChatTopic"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SessionTracker"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SessionCreate"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SessionHistory"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".TestCreator"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Quiz"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Test"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>