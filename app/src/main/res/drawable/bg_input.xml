<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused: green accent border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#141B30" />
            <stroke android:width="1.5dp" android:color="#65D6A3" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#111829" />
            <stroke android:width="1dp" android:color="#232E47" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</selector>